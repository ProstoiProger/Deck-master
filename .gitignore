# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env
.env.*

# ---- build outputs and caches (cli.py build, preview, charts) ----------------------
build/
.cache/
runs/
log.jsonl
*.log

# ---- editors, OS, agent tools -----------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
.deck-master/

# ---- private reference screenshots (see references/design/inspiration/README.md) ---
assets/inspiration/*
!assets/inspiration/.gitkeep

# ---- downloaded Minecraft character images ----------------------------------------
# Mojang/Microsoft property: personal use only, never redistributed (references/design/entities.md).
assets/entities/*
!assets/entities/.gitkeep

# ---- examples: built files and previews embed the downloaded characters ------------
# Rebuild them with: python scripts/cli.py build examples/<folder>/<deck>.md --out build
# Force-add a file only if it contains no Mojang characters: git add -f <file>
examples/**/*.pptx
examples/**/*.pdf
examples/**/preview.png
